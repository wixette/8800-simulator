{
  "name": "8800-simulator",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "description": "The Altair 8800 in your browser: a working front panel, an ASR-33 Teletype, Microsoft's original 4K BASIC, and an 8080 assembler.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test",
    "test:browser": "node tests/browser/run.mjs",
    "stamp": "node tools/stamp.mjs",
    "icons": "node tools/icons.mjs",
    "shots": "node tools/shots.mjs",
    "video": "node tools/video.mjs",
    "version": "node tools/stamp.mjs",
    "typecheck": "npx --yes -p typescript@5.9.3 tsc -p tsconfig.json",
    "build:model": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --factory-startup --python-exit-code 1 --python model/blender/scripts/build_whole_box.py"
  }
}
